# Copy to .env (git-ignored) and fill in. Keys stay on the server.
GEMINI_API_KEY=
# gemini-flash-lite-latest answers in under a minute; gemini-flash-latest is stronger but can be much slower
GEMINI_MODEL=gemini-flash-lite-latest
# Thinking tokens for Flash models; 0 keeps them fast. Leave blank for the model default (slow).
GEMINI_THINKING_BUDGET=0

ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
JOBVETTA_API_KEY=
HIMALAYAS_ENABLED=true
# Remote jobs open to this country (blank = worldwide)
HIMALAYAS_COUNTRY=India

# Salaries are shown in rupees using live rates; this is the fallback if rates cannot be fetched
USD_INR=95

# MySQL is optional. Without it, resumes stay in browser LocalStorage and job results are not cached.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=careerforge

# Port for the dev server. macOS reserves 5000 for AirPlay Receiver, so use 5001 there.
PORT=5000
